# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Gemini AI (optional — LLM interpretation disabled if missing)
GEMINI_API_KEY=your-gemini-api-key-here

# Orçamento diário de chamadas ao LLM (opcional, padrão 50)
LLM_DAILY_LIMIT=50

# Nota: o mínimo de itens BFI-2-S para liberar a análise (30) NÃO é
# configurável por ambiente — vem do instrumento (RN002), não da operação.
